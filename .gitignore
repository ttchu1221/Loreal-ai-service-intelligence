# This repository was initialized in a shared Python workspace. Ignore everything
# by default and explicitly include only this project's files.
/*
!/.gitignore
!/AGENTS.md
!/CHANGELOG.md
!/Dockerfile
!/README.md
!/pyproject.toml
!/config/
!/config/**
!/data/
!/data/README.md
!/data/raw/
!/data/raw/.gitkeep
!/data/interim/
!/data/interim/.gitkeep
!/data/processed/
!/data/processed/.gitkeep
!/docs/
!/docs/**
!/sandbox/
!/sandbox/**
!/scripts/
!/scripts/**
!/src/
!/src/**
!/tests/
!/tests/**

# Local and generated files inside included directories
**/__pycache__/
**/*.py[cod]
**/.DS_Store
# 所有 runtime env 文件均禁止进入 Git；可提交模板统一使用 *.example。
**/*.env
**/.env
**/.env.*
/.venv/
/.pytest_cache/
/.ruff_cache/
/.coverage
/htmlcov/
/*.egg-info/
/dist/
/build/

# Runtime data must not be committed. Only the directory structure is tracked.
/data/raw/**
!/data/raw/.gitkeep
/data/interim/**
!/data/interim/.gitkeep
/data/processed/**
!/data/processed/.gitkeep
/data/mongodb/**
/sandbox/output/**
!/sandbox/output/.gitkeep
